{%- set nginx_worker_processes=environ('NGINX_WORKER_PROCESSES') or "1" -%}
{%- set nginx_worker_connections=environ('NGINX_WORKER_CONNECTIONS') or "1024" -%}
{%- set nginx_proxy_send_timeout=environ('PROXY_SEND_TIMEOUT') or "600" -%}
{%- set nginx_max_body_size=environ('MAX_BODY_SIZE') or "209715200" -%}
{%- set nginx_subpath=environ('SUBPATH') or "/trident" -%}
{%- set nginx_x_frame_options=environ('X_FRAME_OPTIONS') or 'DENY' -%}
{%- set disable_nginx_auth_request=environ('DISABLE_NGINX_AUTH_REQUEST') -%}
{%- set _env=environ('ENV') -%}
{%- set mode=environ('MODE') -%}
{%- set nginx_config_proxy_header_host=environ('NGINX_CONFIG_PROXY_HEADER_HOST') or "$http_host" -%}
{%- set nginx_config_proxy_header_scheme=environ('NGINX_CONFIG_PROXY_HEADER_SCHEME') or "$real_http_x_scheme" -%}

worker_processes {{ nginx_worker_processes }};
worker_priority -20;
worker_cpu_affinity auto;

pid /tmp/nginx.pid;
error_log /dev/fd/2;

events {
    worker_connections {{ nginx_worker_connections }};
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;
    client_max_body_size {{ nginx_max_body_size }};
    client_body_buffer_size 128k;
    proxy_connect_timeout    600;
    proxy_read_timeout       {{ nginx_proxy_send_timeout }};
    proxy_send_timeout       {{ nginx_proxy_send_timeout }};
    grpc_connect_timeout     600;
    grpc_read_timeout        3600;
    grpc_send_timeout        3600;
    proxy_hide_header        Server;
    server_tokens            off;
    {% if mode == "SERVICE" %}http2                    on;{% endif %}

    gzip  on;
    gzip_buffers     4 8k;
    gzip_types
        text/css
        text/javascript
        text/xml
        text/plain
        text/x-component
        application/javascript
        application/json
        application/xml
        application/rss+xml
        font/truetype
        font/opentype
        application/font-woff
        application/vnd.ms-fontobject
        image/svg+xml
        image/jpeg
        image/png
        application/wasm;

    client_body_temp_path /tmp/client_body;
    fastcgi_temp_path /tmp/fastcgi_temp;
    proxy_temp_path /tmp/proxy_temp;
    scgi_temp_path /tmp/scgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;

    map $sent_http_content_type $cache_control_type {
        default        "private";
        ~text/html     "no-store, no-transform";
    }

    log_format main '$real_ip - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '$request_length $request_time $upstream_response_time '
                    '"$http_referer" "$http_user_agent"';

    map $http_x_real_ip $real_ip {
        default $http_x_real_ip;
        "" $remote_addr;
    }

    map $http_x_scheme $real_http_x_scheme {
        default $http_x_scheme;
        "" $scheme;
    }

    map $http_x_original_request_uri $original_request_uri {
        default $http_x_original_request_uri;
        "" $real_http_x_scheme://$http_host$request_uri;
    }

    map $sent_http_content_type $cache_control_type {
        default                    "private";
        ~text/html                 "no-store, no-transform";
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $request_uri $match_api {
        ~^(/trident)?/api/v1/htsc/sso-login 1;
        default 0;
    }

    add_header Cache-Control $cache_control_type;

    server {
        listen       8080;
        listen       8000;
        server_name  _;
        access_log /dev/fd/1 main;
        error_log  /dev/fd/2 error;

{% if mode == "SERVICE" %}
        location / {
            grpc_pass grpc://127.0.0.1:50060;
        }
{% else %}
{%- if _env == 'swhysc' %}

{%- else %}
        add_header X-Frame-Options {{ nginx_x_frame_options }};
{%- endif %}

        index index.html;

        if ($http_user_agent !~* (Chrome|Chromium|iPad|iPhone|UCBrowser|Android)) {
            set $unsupport_browser 1;
            rewrite ^/index.html /browser.html last;
        }
{% if _env == 'htsc' %}
        set $api_unsupport_browser "${match_api}${unsupport_browser}";

        if ($api_unsupport_browser = "11" ) {
            rewrite .* /browser.html last;
        }

        location ^~ /sx/ {
            gzip_static on;
            open_file_cache max=64 inactive=30d;
            open_file_cache_min_uses 8;
            open_file_cache_valid 5s;
            alias /opt/trident/user_proxy/static/;
        }
{% endif %}
        rewrite ^({{ nginx_subpath }})$ $real_http_x_scheme://$http_host$1/ redirect;
        rewrite ^({{ nginx_subpath }})/(.*)$ /$2 last;
{% if _env == 'cgs-autodoc' %}
        location ^~ /idp/api/v1/ {
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $real_ip;
            proxy_set_header X-Real-FULLURL $original_request_uri;
            proxy_set_header X-Scheme $real_http_x_scheme;
            proxy_set_header X-Original-Request-URI $original_request_uri;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_pass http://127.0.0.1:18000/api/v1/;
        }

        location ^~ /idp/ {
            gzip_static on;
            open_file_cache max=64 inactive=30d;
            open_file_cache_min_uses 8;
            open_file_cache_valid 5s;
            alias /opt/trident/user_proxy/static/;
        }
{% endif %}
{% if _env in ["citics", "csc-ipo", "swsc"] %}
        location / {
            {% if not disable_nginx_auth_request %}auth_request /api/v1/user/me;{% endif %}
            {% if _env == "citics" -%}
            error_page 401 403 =302 https://passport.citicsinfo.com/passport/authn?remoteAppId=AIDOC@CITICS.COM&spUrl=https://aidoc.citicsinfo.com/api/v1/citics/sso-login;
            {% elif _env == "swsc" -%}
            error_page 401 403 =302 $real_http_x_scheme://$http_host/api/v1/swsc/sso-login;
            {% elif _env == "csc-ipo" -%}
            error_page 401 403 =302 $real_http_x_scheme://$http_host/api/v1/user/cas-login;
            {% endif -%}
            gzip_static on;
            open_file_cache max=64 inactive=30d;
            open_file_cache_min_uses 8;
            open_file_cache_valid 5s;
            root /opt/trident/user_proxy/static/;
        }

        location /static {
            gzip_static on;
            open_file_cache max=64 inactive=30d;
            open_file_cache_min_uses 8;
            open_file_cache_valid 5s;
            root /opt/trident/user_proxy/static/;
        }
{% else %}
        location / {
            gzip_static on;
            open_file_cache max=64 inactive=30d;
            open_file_cache_min_uses 8;
            open_file_cache_valid 5s;
            root /opt/trident/user_proxy/static/;
        }
{% endif %}
        location ^~ /api/ {
        {%- if _env == 'fullgoal' %}
            {%- if nginx_config_proxy_header_host == '' %}
            proxy_set_header Host $http_host;
            {%- else %}
            proxy_set_header Host "{{ nginx_config_proxy_header_host }}";
            {%- endif %}
            proxy_set_header X-Real-IP $real_ip;
            proxy_set_header X-Real-FULLURL $original_request_uri;
            proxy_set_header X-Scheme "{{ nginx_config_proxy_header_scheme }}";
            proxy_set_header X-Original-Request-URI $original_request_uri;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        {%- else %}
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $real_ip;
            proxy_set_header X-Real-FULLURL $original_request_uri;
            proxy_set_header X-Scheme $real_http_x_scheme;
            proxy_set_header X-Original-Request-URI $original_request_uri;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        {%- endif %}
            proxy_pass http://127.0.0.1:18000/api/;
        }

	    location =/ {
	        gzip_static on;
	        open_file_cache max=64 inactive=30d;
	        open_file_cache_min_uses 8;
	        open_file_cache_valid 5s;
	        root /opt/trident/user_proxy/static/;
	    }
{% endif %}
    }
}
